{
  "name": "voicestream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "concurrently": "^10.0.5",
    "hono": "^4.13.4",
    "raindrop-fx": "^1.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^5.4.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
