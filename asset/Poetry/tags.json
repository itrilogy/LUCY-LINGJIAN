  "sound_map": {
    "comment": "VoiceStream catalog / background 標籤 → 本體系 tags。播放頁先把當前軌道收成 play_tags，再展開。",
    "noise": ["noise", "still", "zen", "mist"],
    "white": ["noise", "still", "mist", "vast"],
    "pink": ["noise", "warmth", "room"],
    "brown": ["noise", "still", "room"],
    "babble": ["babble", "inn", "city", "wine"],
