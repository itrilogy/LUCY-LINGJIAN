  "mix_combine": {
    "comment": "多軌混音：各軌展開後去重。命中時 quote.tags 與 expanded 的交集越大越好；quote 多出的標籤輕罰。單標籤走 defaults。",
    "hit_weight": 3,
    "extra_penalty": 0.35,
    "subset_bonus": 1.2,
    "layout_bias": {
      "quietnight": "vertical",
      "night": "vertical",
      "rain": "vertical",
      "ocean": "horizontal",
      "babble": "horizontal",
      "fire": "vertical"
    },
