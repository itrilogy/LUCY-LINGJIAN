      "night": ["night-time", "still", "moon"],
      "quietnight": ["quietnight", "still", "sleep"],
      "fire": ["fire", "warmth", "lamp"],
      "ocean": ["ocean", "vast", "moon"],
      "stream": ["stream", "ease", "forest"],
      "thunder": ["thunder", "storm", "awe"],
      "noise": ["still", "zen"],
      "traffic": ["travel"]
