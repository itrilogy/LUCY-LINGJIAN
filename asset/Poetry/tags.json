{
  "version": 1,
  "script": "zh-Hant",
  "purpose": "播放頁金句命中：依混音種類、聲音標籤、畫面意境，抽一首詩詞的題名與一兩句。本文檔是播放側展開規則。語料對號入座請用同目錄 label_schema.json（含定義、線索、正反例、play_seats）。",
  "label_authority": "label_schema.json",
  "display": {
    "font_stack": ["Source Han Serif TC", "Noto Serif TC", "Songti TC", "Kaiti TC", "PMingLiU", "serif"],
    "default_layout": "vertical",
    "layouts": {
      "vertical": {
        "id": "vertical",
        "label": "豎排",
        "direction": "ttb-rtl",
        "title": "詩題小字在右或上",
        "body": "一句一行，兩句為一聯",
        "prefer_forms": ["五言", "七言"]
      },
      "horizontal": {
        "id": "horizontal",
        "label": "橫排",
        "direction": "ltr",
        "title": "詞牌／詩題在上，作者在側",
        "body": "一句一行或用空格斷開",
        "prefer_forms": ["小令", "絕句橫題"]
      }
    },
    "fields_on_screen": ["title", "lines", "author"]
  },
  "quote_record": {
    "id": "穩定短 id，建議 author-title-lineIndex",
    "title": "詩題或詞牌，繁體",
    "author": "作者，繁體",
    "dynasty": "先秦|漢|魏晉|唐|宋|元|明|清|近代",
    "form": "五言絕句|七言絕句|五言律|七言律|樂府|古風|小令|長調|散曲",
    "lines": "長度 1–2 的字串陣列，即金句",
    "full_optional": "全詩可另存，不進播放頁",
    "tags": "本文件 facets.*.id 的子集",
    "layout": "vertical|horizontal|either",
    "weight": "可選 0–1，默認 1，用於同標籤內加權抽籤",
    "notes": "可選，校勘／不宜橫排等"
  },
